# =============================================================================
# AI Brain Environment Configuration Template (.env.example)
#
# Copy this file to .env and configure values before starting Docker services.
# NEVER commit production credentials or actual private keys to version control.
# =============================================================================

# Deployment Environment ('development', 'test', 'production')
AI_BRAIN_ENV=production
AI_BRAIN_DEBUG=false
AI_BRAIN_LOG_FORMAT=json

# Storage Backend ('postgres' or 'sqlite')
AI_BRAIN_STORAGE_BACKEND=postgres

# PostgreSQL Connection Credentials
POSTGRES_DB=ai_brain
POSTGRES_USER=ai_brain_user
POSTGRES_PASSWORD=replace_with_strong_random_password_here
DATABASE_URL=postgresql://ai_brain_user:replace_with_strong_random_password_here@postgres:5432/ai_brain

# Database Connection Pool Settings
AI_BRAIN_POOL_SIZE=10
AI_BRAIN_MAX_OVERFLOW=20
AI_BRAIN_POOL_TIMEOUT=30.0
AI_BRAIN_POOL_RECYCLE=1800

# Authentication & Cryptographic Security
AI_BRAIN_DEFAULT_PROJECT_ID=default
AI_BRAIN_JWT_ALGORITHM=RS256
AI_BRAIN_JWT_SECRET=replace_with_at_least_32_characters_secret_key!
AI_BRAIN_JWT_ISSUER=ai-brain
AI_BRAIN_JWT_AUDIENCE=ai-brain-api
AI_BRAIN_TOKEN_EXPIRE_MINUTES=60
AI_BRAIN_API_KEY_PREFIX=agy

# Vector & Embedding Settings
AI_BRAIN_EMBEDDING_DIMENSION=384
AI_BRAIN_HNSW_M=16
AI_BRAIN_HNSW_EF_CONSTRUCTION=64
AI_BRAIN_HNSW_EF_SEARCH=40

# Background Worker Fleet Settings
AI_BRAIN_WORKER_CONCURRENCY=4
AI_BRAIN_LEASE_DURATION=300
AI_BRAIN_HEARTBEAT_INTERVAL=30
AI_BRAIN_POLL_INTERVAL=1.0
AI_BRAIN_MAX_TASK_RETRIES=3

# Observability (Prometheus & Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password
